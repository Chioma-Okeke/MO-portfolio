# Files that stay on this machine when deploying with `vercel --prod`.
# Note: the Vercel CLI ignores .gitignore, so the git-ignored photos in /public still get deployed.

# Private documents and design mockups
resumes
designs

# Project briefs dropped into /public for reference - not for the live site
public/*.docx
public/*_Brief.pdf

# Uncompressed originals; the site uses the .jpg copies next to them.
# Listed one by one so any new photo you add is deployed by default.
public/me/contact-page.png
public/me/scrapbook-image1.png
public/me/scrapbook-image2.png
public/me/scrapbook-image3.png
public/me/scrapbook-image4.png
public/me/about-scrap1.png
public/me/about-scrap2.png
public/me/about-scrap3.png
public/me/about-scrap4.png

# Local secrets (production uses the env vars set in the Vercel dashboard)
.env*.local
